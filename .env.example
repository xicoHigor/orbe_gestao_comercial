NODE_ENV=development
PORT=3001
DATABASE_PATH=./data/comercial.sqlite
APP_URL=http://localhost:5173
# Defina como true se o sistema ficar atrás de proxy reverso (Nginx, Caddy etc.).
TRUST_PROXY=false

# Configure estes valores para enviar e-mails de recuperação de senha.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
