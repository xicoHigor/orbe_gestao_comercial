{
  "name": "gestao-comercial",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.5" },
  "scripts": {
    "dev": "concurrently -k \"npm:server:dev\" \"npm:client:dev\"",
    "server:dev": "node --watch server/index.js",
    "client:dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "start": "cross-env NODE_ENV=production node server/index.js",
    "test": "node --test",
    "desktop:dev": "npm run build && cross-env NODE_ENV=production electron .",
    "desktop:build": "npm run build && electron-builder --win nsis portable"
  },
  "dependencies": {
    "dotenv": "^16.6.1", "express": "^5.1.0", "lucide-react": "^0.468.0",
    "nodemailer": "^10.2.1", "react": "^19.1.0", "react-dom": "^19.1.0", "recharts": "^2.15.4"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.7.0", "concurrently": "^9.2.0", "cross-env": "^7.0.3",
    "vite": "^6.3.5", "electron": "45.2.1", "electron-builder": "26.18.1"
  },
  "productName": "Orbe Comercial",
  "main": "desktop/main.cjs",
  "build": {
    "appId": "br.com.orbe.gestaocomercial", "productName": "Orbe Comercial", "asar": true,
    "directories": { "output": "release" },
    "files": ["desktop/**/*", "server/**/*", "dist/**/*", "package.json"],
    "win": { "target": ["nsis", "portable"], "artifactName": "${productName}-${version}-${arch}.${ext}" },
    "nsis": {
      "oneClick": false, "perMachine": false, "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true, "createStartMenuShortcut": true, "runAfterFinish": true,
      "deleteAppDataOnUninstall": false
    },
    "portable": { "artifactName": "${productName}-${version}-portatil.${ext}" }
  }
}
